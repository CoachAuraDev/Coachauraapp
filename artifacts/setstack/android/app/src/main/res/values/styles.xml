<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@color/setstack_secondary_text</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="colorButtonNormal">@color/setstack_elevated</item>
        <item name="android:colorBackground">@color/setstack_background</item>
        <item name="android:windowBackground">@color/setstack_background</item>
        <item name="android:textColorPrimary">@color/setstack_text</item>
        <item name="android:textColorSecondary">@color/setstack_secondary_text</item>
        <item name="android:statusBarColor">@color/setstack_background</item>
        <item name="android:navigationBarColor">@color/setstack_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/setstack_background</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/setstack_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/coachaura_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/setstack_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/setstack_background</item>
    </style>
</resources>