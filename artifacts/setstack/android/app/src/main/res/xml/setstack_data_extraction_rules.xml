<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Client data lives in the app's WebView storage. Manual JSON export is
         the supported backup path; don't put client records into OS cloud
         backup or device-to-device transfer without the trainer's choice. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
